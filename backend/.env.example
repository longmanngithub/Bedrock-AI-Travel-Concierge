# ---------------------------------------------------------------------------
# AI Travel Concierge — environment configuration
# Copy this file to `.env` and fill in your key.
# ---------------------------------------------------------------------------

# ---- LLM provider (provider-agnostic via LiteLLM naming) --------------------
# ACTIVE: Vertex AI (Google Cloud) — RECOMMENDED if you have Google Cloud
# credit. NO api key, NO 15 req/min free-tier limit. Auth via Application
# Default Credentials:
#     gcloud auth application-default login
# Then set your project id and region:
MODEL=vertex_ai/gemini-2.5-flash-lite
JUDGE_MODEL=vertex_ai/gemini-2.5-flash-lite
VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=global   # use "global" to access the newest models (e.g. 3.5)

# Optional experiment: give ONLY the Planner + Reviewer a stronger model. In our
# 6-scenario test this did NOT beat all-lite (slower, more hallucinations), so we
# leave it off — but the plumbing is here if you want to try it on your data.
# QUALITY_MODEL=vertex_ai/gemini-3.5-flash

# ---- Fallback: Gemini Developer API (free tier, no credit card required) ---
# To switch back, comment the vertex_ai lines above and uncomment these:
# MODEL=gemini/gemini-3.1-flash-lite
# JUDGE_MODEL=gemini/gemini-3.1-flash-lite
# Get a key at https://aistudio.google.com  ->  "Get API key".
# Alternatives that avoid future model-deprecation 404s: gemini/gemini-flash-latest
# (always points to the current Flash) or gemini/gemini-3-flash (more capable).
# GOOGLE_API_KEY=your-gemini-api-key-here

# ---- To switch providers, comment the blocks above and use ONE block below -
# Groq (fast, free tier): https://console.groq.com/keys
# MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=your-groq-api-key-here
#
# Ollama (fully local, no key). Requires `ollama serve` running.
# MODEL=ollama/llama3.1
# OLLAMA_API_BASE=http://localhost:11434

# ---- Model tiers (optional; the "cheapest capable model per task") ----------
# Each task (extraction/reply/answer/research/planner/reviewer/judge) maps to a
# tier. Unset tiers fall back quality->standard->cheap->MODEL, so leaving these
# blank reproduces today's single-model behaviour. See app/routing.py.
# TIER_CHEAP=vertex_ai/gemini-2.5-flash-lite
# TIER_STANDARD=vertex_ai/gemini-2.5-flash
# TIER_QUALITY=vertex_ai/gemini-2.5-pro
# TASK_TIERS=extraction=cheap,reply=cheap,answer=standard,research=cheap,planner=quality,reviewer=quality,judge=standard

# ---- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Change if you use a local Postgres install.
DATABASE_URL=postgresql+psycopg2://concierge:concierge@localhost:5432/concierge
# SQLAlchemy pool sizing per process (see WEB_CONCURRENCY below for how these
# multiply). Defaults are fine for local dev / a single 4 GB prod droplet.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ---- uvicorn worker processes (production only; see backend/entrypoint.sh) --
# Number of API worker processes. Only the API container scales this — the
# crew never runs here (see main.py), so it stays cheap even at 2+ workers.
# WEB_CONCURRENCY=2

# ---- Redis / background jobs (arq) ------------------------------------------
# The crew runs in a background worker, not in the request. Redis holds live
# progress; Postgres is the source of truth. Matches docker-compose.yml.
REDIS_URL=redis://localhost:6379/0
# In-process worker concurrency (one process). 2 is right for a 4 GB box.
# WORKER_MAX_JOBS=2

# ---- Auth -------------------------------------------------------------------
# HS256 signing secret for short-lived access tokens. Generate a long random
# string for anything beyond localhost:  openssl rand -hex 32
JWT_SECRET=dev-insecure-change-me
# Set true behind HTTPS (production) so cookies get the Secure flag. Keep false
# for plain-http localhost or the browser drops the cookie.
COOKIES_SECURE=false
# Frontend origin the Google OAuth callback redirects back to.
FRONTEND_URL=http://localhost:5173
# A signed-in account is required to use the chatbot at all (see README > Auth
# setup for the Google Cloud Console steps to make the button below work).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Grounded data sources (Phase 2; each independently optional) -----------
# Tavily — LLM-oriented web search returning real URLs, so results are
# citable (the DuckDuckGo fallback returns snippets only, no URLs). Free tier
# at https://tavily.com.
# TAVILY_API_KEY=
# Google Places (the classic Text Search API, not only "Places API (New)" —
# enable "Places API" on this key in the console). Verifies a named
# restaurant/hotel/attraction is real; returns address/rating/price level.
# https://console.cloud.google.com/google/maps-apis
# GOOGLE_PLACES_API_KEY=
# Travelpayouts Data API — cached Aviasales/Jetradar search-price data (NOT
# live booking search; their live search API now requires a 50k+ MAU
# affiliate project, which rules it out here). Free: register at
# https://www.travelpayouts.com and connect the Aviasales program for a token.
# TRAVELPAYOUTS_TOKEN=
# Attached to outbound ticket links per Travelpayouts' affiliate terms.
# Defaults to their public demo marker if unset.
# TRAVELPAYOUTS_MARKER=621166

# ---- Delivery / integrations (Phase 4; unset = disabled) --------------------
# RESEND_API_KEY=
# EMAIL_FROM=AI Travel Concierge <onboarding@resend.dev>
# TELEGRAM_BOT_TOKEN=

# ---- Crew topology / experiment toggles -------------------------------------
# All optional; the defaults reproduce the configuration reported in the write-up.
# These can also be driven per-run from the eval harness (see README > Evaluation).
#
# Process: "sequential" (default — deterministic, fewest LLM calls) or
# "hierarchical" (a manager agent delegates to the seven specialists — see
# report/REPORT.md §9 for why this mode measured a ~93% failure rate in a
# full evaluation sweep and sequential should stay the default).
# CREW_PROCESS=sequential
# MANAGER_MODEL=vertex_ai/gemini-2.5-flash-lite   # manager LLM (hierarchical only)
#
# Persist CrewAI long-term memory across runs, embedded LOCALLY with the same
# sentence-transformers model as the RAG store (no external key needed).
# CREW_MEMORY=false
#
# Attach the RAG knowledge_base tool to the agents. Set false for the
# RAG-ablation control condition (crew with retrieval disabled).
# RAG_ENABLED=true

# ---- Misc -------------------------------------------------------------------
# Vertex has no 15 req/min wall, so these can be relaxed for much faster runs.
# On the free Gemini Developer API, lower EVAL_REQUEST_DELAY is not safe —
# use ~4s and MAX_RPM=8 instead (see fallback block above).
EVAL_REQUEST_DELAY=2
# Crew LLM-call throttle. On Vertex this can be high; on the free Developer
# API keep it around 8.
MAX_RPM=60
# Per-LLM-call timeout (seconds) so one stalled call can't hang a whole sweep.
# REQUEST_TIMEOUT=120

# ---- API security -----------------------------------------------------------
# Auth is now account-based (JWT cookies, see the Auth block above) — the old
# X-API-Key gate has been removed. CORS origins still apply for cross-origin
# dev (Next on :5173, API on :8000). In production, prefer same-origin behind
# nginx (/api/* -> backend) so cookies are trivially first-party.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Per-client-IP limit on the LLM-backed endpoints (/chat, /chat/stream,
# /itineraries) — protects against one client burning API budget/quota.
# RATE_LIMIT_GENERATE=20/minute

# ---- Account activation / automatic completion email ------------------------
# A verified Resend sender/domain is required for OTP activation and completed
# response emails in production. OTPs expire after 10 minutes; do not commit
# EMAIL_VERIFICATION_SECRET (a distinct random secret is recommended).
# EMAIL_VERIFICATION_SECRET=
# OTP_TTL_SECONDS=600
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5

# ---- Avatar storage ----------------------------------------------------------
# Development default: AVATAR_STORAGE_BACKEND=local, with files under
# backend/app/data/avatars. Production: use Cloudflare R2's S3-compatible API.
# AVATAR_STORAGE_BACKEND=local
# AVATAR_LOCAL_DIR=/var/lib/bedrock/avatars
# AVATAR_STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=bedrock-avatars
