# Bedrock backend configuration
# Copy to .env and fill in credentials for the providers you use.

# ---- Model routing -------------------------------------------------------------
# Default provider: Vertex AI. Set the project below and run
# gcloud auth application-default login before using this profile.
MODEL=vertex_ai/gemini-2.5-flash-lite
JUDGE_MODEL=vertex_ai/gemini-2.5-flash-lite
# QUALITY_MODEL=vertex_ai/gemini-3.5-flash

# Optional tiers. Unset tiers fall back quality → standard → cheap → MODEL.
# TIER_CHEAP=
# TIER_STANDARD=
# TIER_QUALITY=
# TASK_TIERS=extraction=cheap,reply=cheap,answer=standard,research=cheap,planner=quality,reviewer=quality,judge=standard

# Example: Groq chat, Cloudflare research and planning, Cloudflare GPT-OSS review.
# Replace MODEL and JUDGE_MODEL above, then uncomment the tier settings here.
# MODEL=groq/openai/gpt-oss-120b
# JUDGE_MODEL=groq/openai/gpt-oss-120b
# TIER_STANDARD=cloudflare/@cf/openai/gpt-oss-120b
# TIER_QUALITY=cloudflare/@cf/zai-org/glm-4.7-flash
# TASK_TIERS=extraction=cheap,reply=cheap,answer=cheap,research=quality,planner=quality,reviewer=standard,judge=standard
# GROQ_COMPACT_PLANNING=false

# Groq can reuse the extraction reply on eligible turns to save a model call.
# Leave false for live text streaming.
# GROQ_REUSE_EXTRACTED_REPLY=false

# Other model options. Set MODEL and JUDGE_MODEL for the selected provider.
# MODEL=gemini/gemini-3.1-flash-lite
# MODEL=ollama/llama3.1
# TIER_QUALITY=openrouter/nvidia/nemotron-3.5-super-vl:free

# ---- Model provider credentials ------------------------------------------------
VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=global
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434

# ---- Database ------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://concierge:concierge@localhost:5432/concierge
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ---- Redis and background jobs -------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# WORKER_MAX_JOBS=2
# WEB_CONCURRENCY=2

# ---- Crew limits and evaluation ------------------------------------------------
MAX_RPM=60
EVAL_REQUEST_DELAY=2
# Override MAX_RPM when all crew models run on Cloudflare.
# CLOUDFLARE_CREW_MAX_RPM=30
# Cloudflare review shares this timeout across the first request and one retry.
# REQUEST_TIMEOUT=120
# CREW_PROCESS=sequential
# MANAGER_MODEL=vertex_ai/gemini-2.5-flash-lite
# CREW_MEMORY=false
# RAG_ENABLED=true

# ---- Application URLs and sessions --------------------------------------------
# Use a random JWT secret outside local development and secure cookies with HTTPS.
JWT_SECRET=dev-insecure-change-me
COOKIES_SECURE=false
FRONTEND_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# RATE_LIMIT_GENERATE=20/minute

# ---- Google sign-in ------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Account verification ------------------------------------------------------
# Use a separate random secret and a verified Resend sender for production.
# EMAIL_VERIFICATION_SECRET=
# OTP_TTL_SECONDS=600
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5

# ---- Travel research and pricing ----------------------------------------------
# Google Places uses the classic Text Search API. Flight prices are cached quotes.
# TAVILY_API_KEY=
# GOOGLE_PLACES_API_KEY=
# TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_MARKER=621166

# ---- Email and Telegram delivery ----------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=AI Travel Concierge <onboarding@resend.dev>
# TELEGRAM_BOT_TOKEN=

# ---- Avatar storage ------------------------------------------------------------
# Use local storage for development or set AVATAR_STORAGE_BACKEND=r2.
# AVATAR_STORAGE_BACKEND=local
# AVATAR_LOCAL_DIR=/var/lib/bedrock/avatars
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=bedrock-avatars
