# ---------------------------------------------------------------------------
# Production stack config for docker-compose.prod.yml.
# Copy to `.env` in the repo root and fill in real values, then:
#   docker compose -f docker-compose.prod.yml up -d --build
# See DEPLOYMENT.md for the full DigitalOcean walkthrough.
# ---------------------------------------------------------------------------

# ---- LLM provider (Gemini free tier by default; see backend/.env.example
# for Vertex AI / Groq / Ollama alternatives) --------------------------------
MODEL=gemini/gemini-3.1-flash-lite
JUDGE_MODEL=gemini/gemini-3.1-flash-lite
GOOGLE_API_KEY=your-gemini-api-key-here

# ---- Postgres (used by the db + backend services) --------------------------
POSTGRES_USER=concierge
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=concierge

# ---- Backend API security ---------------------------------------------------
# Required once the API is reachable beyond localhost — every route except
# /health will require this as the X-API-Key header. Generate one with:
#   openssl rand -hex 32
API_KEY=change-me-to-a-random-secret

# Comma-separated origins allowed to call the API from a browser. Must
# include the public URL the frontend is served from.
ALLOWED_ORIGINS=http://localhost:5173,http://YOUR_DROPLET_IP:5173

# Per-client-IP throttle on LLM-backed endpoints.
RATE_LIMIT_GENERATE=20/minute

# ---- Frontend ----------------------------------------------------------------
# Public URL the BROWSER will call — the droplet's IP/domain, not the
# internal "backend" service name. Baked in at image build time.
NEXT_PUBLIC_API_URL=http://YOUR_DROPLET_IP:8000
# Only needed if API_KEY above is set (it is, by default in this file).
NEXT_PUBLIC_API_KEY=change-me-to-a-random-secret
