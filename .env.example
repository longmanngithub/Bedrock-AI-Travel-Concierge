# ---------------------------------------------------------------------------
# Production stack config for docker-compose.prod.yml.
# Copy to `.env` in the repo root and fill in real values, then:
#   docker compose -f docker-compose.prod.yml up -d --build
# See DEPLOYMENT.md for the full DigitalOcean walkthrough.
# ---------------------------------------------------------------------------

# ---- LLM provider (Vertex AI by default; see backend/.env.example for the
# Gemini Developer API / Groq / Ollama alternatives) -------------------------
# Auth is via a GCP service-account key (NOT `gcloud auth application-default
# login` — that's a host-machine flow and doesn't work headless in a
# container). See DEPLOYMENT.md §4 for how to create the key file; it's
# mounted into the backend container by docker-compose.prod.yml and must
# never be committed.
MODEL=vertex_ai/gemini-2.5-flash-lite
JUDGE_MODEL=vertex_ai/gemini-2.5-flash-lite
VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=global
# Path (on the droplet, relative to the repo root) to the downloaded
# service-account key JSON. Defaults to ./gcp-key.json if unset.
GCP_KEY_FILE=./gcp-key.json

# ---- Fallback: Gemini Developer API (free tier, no credit card required) ---
# To switch, comment the vertex_ai lines above and uncomment these instead:
# MODEL=gemini/gemini-3.1-flash-lite
# JUDGE_MODEL=gemini/gemini-3.1-flash-lite
# GOOGLE_API_KEY=your-gemini-api-key-here

# ---- Postgres (used by the db + backend + worker services) -----------------
POSTGRES_USER=concierge
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=concierge

# ---- Auth (account-based; the old X-API-Key gate is gone) ------------------
# HS256 signing secret for access tokens. MUST be a long random string.
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Behind HTTPS in production, keep this true so cookies get the Secure flag.
COOKIES_SECURE=true
# The public origin the frontend is served from (used by the OAuth redirect).
FRONTEND_URL=https://your-domain.example
# A signed-in account is required to use the chatbot at all. Google OAuth below
# is optional (unset disables the Google sign-in button) but the redirect URI
# must be registered in the Google Cloud console if you enable it.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/google/callback

# ---- Optional model tiers (cheapest capable model per task) ----------------
# Unset -> all tiers fall back to MODEL. See app/routing.py.
# TIER_CHEAP=vertex_ai/gemini-2.5-flash-lite
# TIER_STANDARD=vertex_ai/gemini-2.5-flash
# TIER_QUALITY=vertex_ai/gemini-2.5-pro

# ---- Grounded data sources (Phase 2; each independently optional) -----------
# See backend/.env.example for what each one does and where to sign up.
# TAVILY_API_KEY=
# GOOGLE_PLACES_API_KEY=
# TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_MARKER=621166

# ---- Delivery: PDF via email + Telegram (Phase 4; each independently
# optional — unset disables that channel, same "off = graceful no-op"
# pattern as everything above) --------------------------------------------
# Resend (https://resend.com) — powers account email verification AND the
# automatic boarding-pass PDF email sent when a plan finishes. Needs a
# verified sending domain in production (the onboarding@resend.dev sender
# below only delivers to your own Resend account's email in test mode).
# RESEND_API_KEY=
# EMAIL_FROM=AI Travel Concierge <onboarding@resend.dev>
# Separate secret for signing email-verification OTPs; falls back to
# JWT_SECRET above if unset (fine for a single-owner droplet).
# EMAIL_VERIFICATION_SECRET=
# Telegram bot token from @BotFather. Enables automatic itinerary PDF
# delivery to a linked Telegram chat (Settings > Telegram delivery in the
# app) via long-polling (app/queue/telegram_poll.py) — no public webhook URL
# needed, so this works behind the droplet's firewall unmodified.
# TELEGRAM_BOT_TOKEN=

# ---- Avatar storage (optional; "local" needs no config) ---------------------
# AVATAR_STORAGE_BACKEND=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ---- CORS -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. In production,
# prefer same-origin behind nginx (/api/* -> backend) — then this only needs
# your own domain. See DEPLOYMENT.md.
ALLOWED_ORIGINS=https://your-domain.example
# Per-client-IP throttle on LLM-backed endpoints.
RATE_LIMIT_GENERATE=20/minute

# ---- Load / pool tuning (optional; defaults are fine for a 4 GB droplet) ---
# uvicorn worker process count. Only the API container uses this — the crew
# never runs there, so it stays cheap even at 2+ workers. See DEPLOYMENT.md.
# WEB_CONCURRENCY=2
# SQLAlchemy pool size per API/worker process. WEB_CONCURRENCY * DB_POOL_SIZE
# must stay under Postgres's max_connections (default 100).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ---- Frontend ----------------------------------------------------------------
# Public URL the BROWSER will call. With same-origin nginx this is your domain
# (served through /api). Baked into the client bundle at image build time.
NEXT_PUBLIC_API_URL=https://your-domain.example
