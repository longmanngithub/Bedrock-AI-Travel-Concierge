# Base URL of the FastAPI backend (exposed to the browser by Next.js).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: only needed if the backend's API_KEY is set (backend/.env.example).
# Unset by default since the backend has no auth requirement out of the box.
# NOTE: this ships in client-side JS and is visible to anyone using the site —
# it only makes sense as a shared-deployment gate, not a secret.
# NEXT_PUBLIC_API_KEY=
